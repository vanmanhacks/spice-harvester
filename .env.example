# ───────────────────────────────────────────────────────────
# Spice Harvester Environment Configuration
# ───────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — NEVER commit real secrets.
#
# Production deployment (NixOS / VPS):
#   Place at /etc/spice-harvester/env (chmod 600).
#   The directory is created at boot by systemd-tmpfiles.
#
# Local development:
#   cp .env.example .env → docker-compose auto-loads from $PWD.
# ───────────────────────────────────────────────────────────

# ─── API Keys ──────────────────────────────────────────────

# DeepSeek API key for the AI layer:
#   - the Hermes recon profile (suggestion + synthesis, when AI_ENABLED=1)
#   - the direct-API fallback scripts (synthesis_gate.py / ai_suggest.py)
# Uses deepseek-flash for cost-efficient synthesis of large scan results.
# Get yours at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...here

# ─── AI Layer (Hermes recon profile) ───────────────────────

# Enable the self-improving AI layer. When set to 1, suggestion +
# synthesis route through a dedicated Hermes 'recon' profile
# (persistent, self-improving memory across runs), falling back
# to direct-API scripts when the agent produces no usable output.
# Set up the profile first:
#   ./recon-profile/setup.sh recon
# Default 0 = deterministic permutation only + direct-API synthesis
# (the reproducible baseline).
AI_ENABLED=0

# Profile name used by the AI layer (default: recon). Set this per
# engagement (recon-<client>) so memory never bleeds across targets.
RECON_PROFILE=recon

# Optional: wall-clock budgets for the agent, in seconds.
# RECON_SUGGEST_BUDGET=90
# RECON_SYNTH_BUDGET=400

# ─── Low-and-Slow Rate Limits & Timeouts ───────────────────

# HTTP request rates (req/s) — WAF-evasion defaults. Lower = stealthier.
# Applied per tool: httpx (liveness/tech-detect), feroxbuster (directory
# brute), nuclei (vuln templates). ferox/nuclei were already conservative;
# httpx was not. Tune per engagement — a WAF-heavy target wants lower rates.
HTTPX_RATE_LIMIT=20
HTTPX_THREADS=20
FEROX_RATE_LIMIT=10
NUCLEI_RATE_LIMIT=5

# Optional TLS client-hello (JA3) randomization (experimental). Set to 1 for
# bot-walled targets; evades Go-fingerprint detection but may break strict TLS.
TLS_IMPERSONATE=0

# Generous tool timeouts (seconds) — hang-guards, not truncation targets.
# On timeout the pipeline keeps partial results and warns instead of
# failing the whole domain.
SUBFINDER_TIMEOUT=7200
DNSX_TIMEOUT=3600
HTTPX_TIMEOUT=7200
KATANA_TIMEOUT=7200
FEROX_TIMEOUT=14400
NUCLEI_TIMEOUT=14400

# ─── Signal Alerting (via signal-cli / Hermes gateway) ─────

# Signal phone number linked to signal-cli daemon (the sender).
# Format: +123****8900
SIGNAL_ACCOUNT=

# Signal phone number that receives pipeline alerts.
# Format: +109****4321
SIGNAL_RECIPIENT=

# ─── Paths ─────────────────────────────────────────────────

# Spice Harvester installation directory.
# Defaults to ~/spice-harvester if unset.
SPICE_HARVESTER_HOME=~/spice-harvester
